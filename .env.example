# VoxStruct configuration — copy to .env and fill in. .env is gitignored.

# --- LLM API keys (cloud structuring; optional if using a local/LAN LLM) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Remote ASR offload (low-compute: transcribe on another host) ---
# builtin (default, in-process Whisper/Vosk) | remote (HTTP sidecar) | modal (rented GPU)
VOXSTRUCT_ASR_BACKEND=builtin
# Base URL of the remote whisper sidecar (no trailing slash). PRIVATE — your box only.
# e.g. an Atelier MLX-whisper sidecar on the LAN:
VOXSTRUCT_ASR_URL=
# Optional bearer token if the sidecar sets HUB_TOKEN:
VOXSTRUCT_ASR_TOKEN=
# Optional model alias / HF repo for the sidecar (e.g. turbo, large, accurate):
VOXSTRUCT_ASR_MODEL=

# --- Modal GPU ASR (VOXSTRUCT_ASR_BACKEND=modal) ---
# For when no sidecar is reachable and nothing is installed locally (travelling,
# sidecar box powered down). Deploy once:  modal deploy modal/voxstruct_asr.py
# See docs/REMOTE_ASR.md. VOXSTRUCT_ASR_MODEL applies here too (default large-v3).
VOXSTRUCT_MODAL_APP=voxstruct-asr
VOXSTRUCT_MODAL_FUNCTION=transcribe
# Speaker labels on each segment (needs an HF token secret on Modal for pyannote):
VOXSTRUCT_DIARIZE=
# EXACT speaker count, not a hint — guessing splits one person into phantom speakers.
# Leave blank only if you genuinely don't know.
VOXSTRUCT_NUM_SPEAKERS=

# --- LLM endpoint override (run structuring off-box, e.g. LAN Ollama) ---
# Point litellm at a self-hosted endpoint; pair with --llm-model ollama/<model>.
# e.g. http://<host>:11434  (Ollama)  or  http://<host>:8773/v1  (mlx_lm)
VOXSTRUCT_LLM_API_BASE=
